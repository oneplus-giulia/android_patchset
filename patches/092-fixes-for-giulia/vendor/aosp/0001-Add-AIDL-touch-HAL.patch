From 7174f160e55eec441c4fa3f4e086441aafa1ba91 Mon Sep 17 00:00:00 2001
From: Luca Stefani <luca.stefani.ge1@gmail.com>
Date: Wed, 19 Mar 2025 18:15:02 +0100
Subject: [PATCH] Add AIDL touch HAL

Change-Id: I9b54a662bf09ff1bfe26ac1d0585595b3d21f2b0
---
 config/device_framework_matrix.xml | 30 +++++++++++++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/config/device_framework_matrix.xml b/config/device_framework_matrix.xml
index 38447f0a..1220176b 100644
--- a/config/device_framework_matrix.xml
+++ b/config/device_framework_matrix.xml
@@ -1,6 +1,6 @@
 <?xml version="2.0" encoding="UTF-8"?>
 <!--
-     Copyright (C) 2021-2023 The LineageOS Project
+     Copyright (C) 2021-2025 The LineageOS Project
      SPDX-License-Identifier: Apache-2.0
 -->
 <compatibility-matrix version="2.0" type="framework">
@@ -128,6 +128,34 @@
         </interface>
     </hal>
     <!-- Touch -->
+    <hal format="aidl" optional="true">
+        <name>vendor.lineage.touch</name>
+        <version>1</version>
+        <interface>
+            <name>IGloveMode</name>
+            <instance>default</instance>
+        </interface>
+        <interface>
+            <name>IHighTouchPollingRate</name>
+            <instance>default</instance>
+        </interface>
+        <interface>
+            <name>IKeyDisabler</name>
+            <instance>default</instance>
+        </interface>
+        <interface>
+            <name>IKeySwapper</name>
+            <instance>default</instance>
+        </interface>
+        <interface>
+            <name>IStylusMode</name>
+            <instance>default</instance>
+        </interface>
+        <interface>
+            <name>ITouchscreenGesture</name>
+            <instance>default</instance>
+        </interface>
+    </hal>
     <hal format="hidl" optional="true">
         <name>vendor.lineage.touch</name>
         <version>1.0</version>
-- 
2.49.0

