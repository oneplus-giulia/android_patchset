+package com.android.settings.enhance;
+
+import android.content.Context;
+
+import com.android.settings.core.BasePreferenceController;
+
+public class EnhancePreferenceController extends BasePreferenceController {
+
+    public EnhancePreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+}
