+package com.android.settings.enhance;
+
+import com.android.settings.R;
+import com.android.settings.dashboard.DashboardFragment;
+
+public class EnhanceSettings extends DashboardFragment {
+
+    private static final String TAG = "EnhanceSettings";
+
+    @Override
+    public int getMetricsCategory() {
+        return -1;
+    }
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        return R.xml.enhance_settings;
+    }
+
+    @Override
+    protected String getLogTag() {
+        return TAG;
+    }
+}
