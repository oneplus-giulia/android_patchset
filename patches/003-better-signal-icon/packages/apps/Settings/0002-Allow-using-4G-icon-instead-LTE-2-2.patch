From 42c7d42d5c6814f1598e446b1b844a89d63466d3 Mon Sep 17 00:00:00 2001
From: Pranav Vashi <neobuddy89@gmail.com>
Date: Wed, 19 Jul 2017 23:46:45 +0530
Subject: [PATCH] Allow using 4G icon instead LTE [2/2]

Signed-off-by: Pranav Vashi <neobuddy89@gmail.com>
---
 res/values-zh-rCN/custom_strings.xml | 3 +++
 res/values/custom_strings.xml        | 4 ++++
 res/xml/enhance_settings.xml         | 6 ++++++
 3 files changed, 13 insertions(+)

diff --git a/res/values-zh-rCN/custom_strings.xml b/res/values-zh-rCN/custom_strings.xml
index d0167f3d61e..e959549381b 100644
--- a/res/values-zh-rCN/custom_strings.xml
+++ b/res/values-zh-rCN/custom_strings.xml
@@ -279,4 +279,7 @@
     <!-- Data disabled indicator -->
     <string name="data_disabled_icon_title">数据禁用指示器</string>
     <string name="data_disabled_icon_summary">当禁用数据连接时，显示信号图标旁边感叹号</string>
+    <!-- 4G icon -->
+    <string name="show_fourg_icon_title">显示 4G 图标</string>
+    <string name="show_fourg_icon_summary">在信号图标上显示 4G 而非 LTE</string>
 </resources>
diff --git a/res/values/custom_strings.xml b/res/values/custom_strings.xml
index 11710a87f9a..fd94b1ea148 100644
--- a/res/values/custom_strings.xml
+++ b/res/values/custom_strings.xml
@@ -323,4 +323,8 @@
     <string name="data_disabled_icon_title">Data disabled indicator</string>
     <string name="data_disabled_icon_summary">Display an indicator next to signal icon when data is disabled</string>
 
+    <!-- 4G icon -->
+    <string name="show_fourg_icon_title">Show 4G icon</string>
+    <string name="show_fourg_icon_summary">Display 4G icon in signal icon instead LTE</string>
+
 </resources>
diff --git a/res/xml/enhance_settings.xml b/res/xml/enhance_settings.xml
index 7b13c970012..432c1621a63 100644
--- a/res/xml/enhance_settings.xml
+++ b/res/xml/enhance_settings.xml
@@ -38,4 +38,10 @@
         android:summary="@string/data_disabled_icon_summary"
         android:defaultValue="true" />
 
+    <com.android.settings.custom.preference.SystemSettingSwitchPreference
+        android:key="show_fourg_icon"
+        android:title="@string/show_fourg_icon_title"
+        android:summary="@string/show_fourg_icon_summary"
+        android:defaultValue="true" />
+
 </PreferenceScreen>
-- 
2.49.0

